{
  "name": "mqtt-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents talk to MQTT brokers and IoT devices",
  "type": "module",
  "bin": {
    "mqtt-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "simulator": "tsx simulator/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mqtt",
    "iot",
    "ai",
    "agents",
    "emqx"
  ],
  "author": "Dušan Veselinović",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mqtt": "^5.16.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
